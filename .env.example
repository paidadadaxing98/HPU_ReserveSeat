SEAT_ACCOUNT=
SEAT_PASSWORD=
SEAT_CONTROL_TOKEN=replace-with-a-long-random-token
SEAT_DRY_RUN=true
SEAT_DB_PATH=seat_assistant.db
SEAT_CONTROL_HOST=127.0.0.1
SEAT_WECOM_WEBHOOK=
SEAT_LOGIN_URL=https://seatlib.hpu.edu.cn/libseat/
SEAT_MAX_RESERVATIONS_PER_RUN=1
SEAT_DAILY_SUCCESS_LIMIT=3
SEAT_ACCOUNT_INTERVAL_SECONDS=15
# Optional captcha vision fallback. Disabled until a key is configured.
SEAT_CAPTCHA_LLM_ENABLED=false
SEAT_CAPTCHA_LLM_API_KEY=
SEAT_CAPTCHA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEAT_CAPTCHA_LLM_MODEL=qwen3.7-flash
SEAT_CAPTCHA_LLM_TIMEOUT_SECONDS=15
SEAT_CAPTCHA_LLM_MAX_ATTEMPTS=2
# Optional multi-account file. When present, accounts.json takes precedence
# over SEAT_ACCOUNT/SEAT_PASSWORD and supports up to 20 isolated accounts.
SEAT_ACCOUNTS_FILE=accounts.json
